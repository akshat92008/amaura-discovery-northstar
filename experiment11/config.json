{
  "experiment_id": "Amaura_Experiment_11",
  "domain": "Permutation Flow Shop Scheduling (PFSP - Fm | prmu | C_max)",
  "objective": "Minimize total makespan C_max across unseen test instances",
  "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
  "api_base_url": "http://127.0.0.1:20128/v1/chat/completions",
  "api_key": "",
  "temperature": 0.6,
  "max_completion_tokens": 4096,
  "calls_per_condition_per_trial": 15,
  "conditions": [
    "Condition_A_Independent",
    "Condition_C_BehavioralDiversity"
  ],
  "num_trials": 5,
  "total_llm_calls": 150,
  "qd_archive": {
    "delta_min": 0.20,
    "max_archive_size": 10,
    "metric": "Kendall_Tau_Permutation_Distance",
    "pruning_rule": "pairwise_minimum_distance_remove_worse_score"
  },
  "computational_budget": {
    "scale_aware_timeout_base_ms": 1000.0,
    "scale_aware_timeout_per_nm_ms": 2.0,
    "formula": "T(n, m) = 1000.0 + 2.0 * (n * m) ms",
    "sigalrm_interrupt_sec": 10,
    "recommended_max_evals_per_instance": 15000
  },
  "quality_control": {
    "max_invalid_rate_threshold": 0.15,
    "max_truncation_rate_threshold": 0.05
  },
  "benchmark_split": {
    "dev_instances": 30,
    "dev_seed": 1042,
    "hidden_instances": 120,
    "hidden_seed": 70099
  }
}
